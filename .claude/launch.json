{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "routeagent",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "streamlit",
        "run",
        "app/streamlit_app.py",
        "--server.address",
        "127.0.0.1",
        "--server.port",
        "8503",
        "--browser.gatherUsageStats",
        "false",
        "--server.headless",
        "true"
      ],
      "port": 8503
    }
  ]
}