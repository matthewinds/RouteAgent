# Normal FYP entrypoints only use real online tools. Never commit actual keys.
FYP_MODE=live
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=enabled
ORS_API_KEY=
# ORS is used ONLY for address geocoding; routing uses OSRM without a key.
ORS_GEOCODE_BASE_URL=https://api.heigit.org/pelias/v1
OSRM_DRIVING_BASE_URL=https://routing.openstreetmap.de/routed-car
OSRM_WALKING_BASE_URL=https://routing.openstreetmap.de/routed-foot
OSRM_DRIVING_PROFILE=driving
OSRM_WALKING_PROFILE=foot
# Base URL chooses the prebuilt car/foot graph; a profile name alone cannot switch it.
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Open-Meteo public non-commercial endpoint: no key required.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
# Optional OneMap bearer token for Singapore public transport routes/returned fares.
# Get it from https://www.onemap.gov.sg/apidocs/ ; keep the token only in local .env.
ONEMAP_TOKEN=
ONEMAP_BASE_URL=https://www.onemap.gov.sg/api/public/routingsvc

# Optional open corporate-address source; no credential required.
COMPANY_REGISTRY_BASE_URL=https://api.gleif.org/api/v1
# Optional generic web research when map/registry do not index an office.
# Get a key from https://app.tavily.com/ ; keep it only in local .env.
TAVILY_API_KEY=
LOCATION_SEARCH_BASE_URL=https://api.tavily.com
LTA_API_KEY=
LTA_API_BASE=https://datamall2.mytransport.sg/ltaodataservice
# Optional quota key; the public NEA forecast endpoint can work without this.
DATAGOVSG_API_KEY=
WEATHER_API_BASE=https://api-open.data.gov.sg/v2/real-time/api

# Keep existing Google/OpenRouter credentials in local .env for the old baseline.
# Normal FYP v2 never uses them.
