# Publish only the application, runtime dependencies and configuration template.
/*
!/.gitignore
!/.env.example
!/README.md
!/pyproject.toml
!/requirements.lock.txt
!/.streamlit/
!/app/
!/src/

/src/*
!/src/route_agent/
/src/route_agent/fixtures/
/src/route_agent/experiments/
/.streamlit/*
!/.streamlit/config.toml

.env
.env.*
!.env.example
__pycache__/
*.py[cod]
*.egg-info/
.DS_Store
