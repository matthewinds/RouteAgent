<mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageWidth="1280" pageHeight="1780" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" vertex="1" value="&lt;b&gt;RouteAgent · 當前實現 Pipeline&lt;/b&gt;&lt;br&gt;&lt;br&gt;截至 2026-10-07｜階段是職責劃分，具體工具順序由 Agent 決定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;fontSize=16;spacing=8;arcSize=12;"><mxGeometry as="geometry" x="20" y="15" width="1210" height="75" /></mxCell><mxCell id="input" parent="1" vertex="1" value="&lt;b&gt;用戶自然語言需求&lt;/b&gt;&lt;br&gt;&lt;br&gt;Streamlit 輸入／繼續規劃" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;fontSize=16;spacing=8;arcSize=12;"><mxGeometry as="geometry" x="420" y="115" width="390" height="80" /></mxCell><mxCell id="init" parent="1" vertex="1" value="&lt;b&gt;運行初始化&lt;/b&gt;&lt;br&gt;&lt;br&gt;plan_route：在線配置、run_id、狀態與調用預算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;fontColor=#172033;fontSize=16;spacing=8;arcSize=12;"><mxGeometry as="geometry" x="420" y="215" width="390" height="90" /></mxCell><mxCell id="request" parent="1" vertex="1" value="&lt;b&gt;需求提取與校驗&lt;/b&gt;&lt;br&gt;&lt;br&gt;DeepSeek → set_request → TravelRequest&lt;br&gt;原文證據、硬約束、偏好、個人事實" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#8b5cf6;fontColor=#172033;fontSize=16;spacing=8;arcSize=12;"><mxGeometry as="geometry" x="420" y="330" width="390" height="100" /></mxCell><mxCell id="place" parent="1" vertex="1" value="&lt;b&gt;通用地點解析&lt;/b&gt;&lt;br&gt;&lt;br&gt;resolve_place：地圖／登記信息／網頁&lt;br&gt;檢索假設、來源核驗、必要地點確認" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;fontColor=#172033;fontSize=16;spacing=8;arcSize=12;"><mxGeometry as="geometry" x="420" y="465" width="390" height="100" /></mxCell><mxCell id="agent" parent="1" vertex="1" value="&lt;b&gt;Agent 決定下一步&lt;/b&gt;&lt;br&gt;&lt;br&gt;讀取用戶需求、當前狀態與工具結果&lt;br&gt;按需查詢，不固定遍歷全部來源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#8b5cf6;fontColor=#172033;fontSize=16;spacing=8;arcSize=12;"><mxGeometry as="geometry" x="420" y="600" width="390" height="100" /></mxCell><mxCell id="candidates" parent="1" vertex="1" value="&lt;b&gt;真實候選行程&lt;/b&gt;&lt;br&gt;&lt;br&gt;plan_candidates：OSRM 駕車／步行&lt;br&gt;OneMap 公交／地鐵／步行組合&lt;br&gt;多 POI 比較；累計接駁、等待、換乘與停留" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;fontColor=#172033;fontSize=16;spacing=8;arcSize=12;"><mxGeometry as="geometry" x="420" y="735" width="390" height="120" /></mxCell><mxCell id="verify" parent="1" vertex="1" value="&lt;b&gt;後端逐項驗證&lt;/b&gt;&lt;br&gt;&lt;br&gt;validate_routes ＋ check_lta_routes&lt;br&gt;方式、連接、時序、POI、時間、天氣等&lt;br&gt;pass / fail / unknown；核對證據有效性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;fontColor=#172033;fontSize=16;spacing=8;arcSize=12;"><mxGeometry as="geometry" x="420" y="890" width="390" height="120" /></mxCell><mxCell id="compare" parent="1" vertex="1" value="&lt;b&gt;量化比較與模型選擇&lt;/b&gt;&lt;br&gt;&lt;br&gt;compare_routes：確定性指標與評分&lt;br&gt;DeepSeek 選擇候選 ID 和理由依據" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#8b5cf6;fontColor=#172033;fontSize=16;spacing=8;arcSize=12;"><mxGeometry as="geometry" x="420" y="1045" width="390" height="100" /></mxCell><mxCell id="finish" parent="1" vertex="1" value="&lt;b&gt;發佈檢查&lt;/b&gt;&lt;br&gt;&lt;br&gt;finish_plan：推薦必須通過硬約束&lt;br&gt;每段服務證據與理由核驗&lt;br&gt;軟偏好缺證據仍可令整次結果 unverified" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;fontColor=#172033;fontSize=16;spacing=8;arcSize=12;"><mxGeometry as="geometry" x="420" y="1180" width="390" height="120" /></mxCell><mxCell id="display" parent="1" vertex="1" value="&lt;b&gt;網頁結果&lt;/b&gt;&lt;br&gt;&lt;br&gt;推薦／備選／參考、地圖、完整分段&lt;br&gt;檢查狀態、未核實項、JSON 導出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;fontSize=16;spacing=8;arcSize=12;"><mxGeometry as="geometry" x="420" y="1335" width="390" height="100" /></mxCell><mxCell id="archive" parent="1" vertex="1" value="&lt;b&gt;可追溯運行記錄&lt;/b&gt;&lt;br&gt;&lt;br&gt;outputs/&amp;lt;run_id&amp;gt;/&lt;br&gt;result.json · events.jsonl · manifest.json&lt;br&gt;來源、時間、響應哈希、模型／代碼哈希和指標" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;fontSize=16;spacing=8;arcSize=12;"><mxGeometry as="geometry" x="420" y="1470" width="390" height="115" /></mxCell><mxCell id="clarify" parent="1" vertex="1" value="&lt;b&gt;必要澄清／確認&lt;/b&gt;&lt;br&gt;&lt;br&gt;個人位置、車輛、停留、停車轉換&lt;br&gt;或真實地點候選歧義&lt;br&gt;保留原需求及確認記錄後繼續" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f59e0b;fontColor=#172033;fontSize=16;spacing=8;arcSize=12;"><mxGeometry as="geometry" x="30" y="400" width="300" height="145" /></mxCell><mxCell id="tools" parent="1" vertex="1" value="&lt;b&gt;按需真實數據來源&lt;/b&gt;&lt;br&gt;&lt;br&gt;OSM：POI／道路／營業標籤&lt;br&gt;LTA：交通／停車／33 類動態數據&lt;br&gt;Open-Meteo／NEA：天氣參考&lt;br&gt;OneMap：真實站點&lt;br&gt;&lt;br&gt;所有結果保留來源與證據" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;fontColor=#172033;fontSize=16;spacing=8;arcSize=12;"><mxGeometry as="geometry" x="910" y="585" width="320" height="230" /></mxCell><mxCell id="replan" parent="1" vertex="1" value="&lt;b&gt;驗證反饋 → 重規劃&lt;/b&gt;&lt;br&gt;&lt;br&gt;DeepSeek 決定補查、換門店／站點&lt;br&gt;比較其他方式或擴大有限搜索&lt;br&gt;約束不變；預算允許；重複組合不重查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f59e0b;fontColor=#172033;fontSize=16;spacing=8;arcSize=12;"><mxGeometry as="geometry" x="30" y="925" width="300" height="170" /></mxCell><mxCell id="terminal" parent="1" vertex="1" value="&lt;b&gt;有限搜索或證據缺口&lt;/b&gt;&lt;br&gt;&lt;br&gt;unverified：部分需求尚未核實&lt;br&gt;search_exhausted：有限搜索未找到&lt;br&gt;tool_error：服務／預算未能完成&lt;br&gt;不把工具失敗當成條件無解" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f59e0b;fontColor=#172033;fontSize=16;spacing=8;arcSize=12;"><mxGeometry as="geometry" x="910" y="1180" width="320" height="150" /></mxCell><mxCell id="legend" parent="1" vertex="1" value="&lt;b&gt;職責與邊界&lt;/b&gt;&lt;br&gt;&lt;br&gt;紫：模型決策｜藍：真實服務｜綠：後端驗證&lt;br&gt;橙：反饋／缺口｜灰：用戶界面／運行記錄&lt;br&gt;當前支持單業務經停；部分路況、費用和遮蔽未知須保留" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;fontSize=16;spacing=8;arcSize=12;"><mxGeometry as="geometry" x="20" y="1620" width="1210" height="110" /></mxCell><mxCell id="e0" parent="1" edge="1" source="input" target="init" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#64748b;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" parent="1" edge="1" source="init" target="request" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#64748b;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" parent="1" edge="1" source="request" target="place" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#64748b;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" parent="1" edge="1" source="place" target="agent" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#64748b;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" parent="1" edge="1" source="agent" target="candidates" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#64748b;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" parent="1" edge="1" source="candidates" target="verify" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#64748b;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e6" parent="1" edge="1" source="verify" target="compare" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#64748b;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e7" parent="1" edge="1" source="compare" target="finish" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#64748b;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e8" parent="1" edge="1" source="finish" target="display" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#64748b;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e9" parent="1" edge="1" source="display" target="archive" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#64748b;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="c1" parent="1" edge="1" source="request" target="clarify" value="缺失事實" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#d97706;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="c2" parent="1" edge="1" source="place" target="clarify" value="地點歧義" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#d97706;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="c3" parent="1" edge="1" source="clarify" target="request" value="確認後繼續" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#d97706;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="t1" parent="1" edge="1" source="agent" target="tools" value="調用／反饋" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#64748b;startArrow=classic;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="r1" parent="1" edge="1" source="verify" target="replan" value="失敗／未知" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#d97706;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="r2" parent="1" edge="1" source="replan" target="agent" value="繼續探索" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#d97706;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s1" parent="1" edge="1" source="finish" target="terminal" value="無法完整核實" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#d97706;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s2" parent="1" edge="1" source="terminal" target="display" value="透明輸出" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#d97706;"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel>